projection;
strict ( 2 );
use side effects;
define behavior for ZC_TRAVEL_ROOT_INCH alias _Travel
{
  use create;
  use update;
  use delete;
  use action CopyTravel;

  use association _Booking { create; }
}

define behavior for ZC_BOOKING_INCH_M alias _Booking
{
  use update;
  use delete;

  use association _Travel;
  use association _Suppl { create; }
}

define behavior for ZC_BOOKING_SUPPL_M alias _Suppl
{
  use update;
  use delete;

  use association _Travel;
  use association _booking;
}